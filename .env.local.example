# Resend (https://resend.com) — envío del formulario de contacto
RESEND_API_KEY=

# Opcionales — por defecto usan info@nordictech-corp.com y el remitente sandbox de Resend
# CONTACT_TO_EMAIL=info@nordictech-corp.com
# CONTACT_FROM_EMAIL="Nordictech Web <onboarding@resend.dev>"

# Portal de tickets — endpoints PHP alojados en Bluehost
# Recomendado: conservar Bluehost bajo un subdominio como api.nordictech-corp.com
PORTAL_API_BASE_URL=https://api.nordictech-corp.com/assets/php
# Cambiar solo si PHP usa un nombre de cookie de sesión personalizado
PORTAL_API_SESSION_COOKIE_NAME=PHPSESSID

# Firma la sesión de navegación de Next.js (valor aleatorio de al menos 32 caracteres)
PORTAL_SESSION_SECRET=
